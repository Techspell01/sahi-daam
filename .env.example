# Copy to .env.local and fill in from your Supabase project (Settings → API keys).
# Without these the app runs as in phase 1: demo prices, with your reports kept on the phone.
# For the local stack (npx supabase start), take API_URL and PUBLISHABLE_KEY from `npx supabase status -o env`.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
